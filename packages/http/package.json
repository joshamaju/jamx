{
  "name": "@jamx/http",
  "version": "0.0.0",
  "description": "Composable fetch helpers with interceptors, decoders, validators, and Railway-style results.",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --w",
    "test": "vitest run",
    "prepublish": "pnpm build",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "version": "changeset version",
    "release": "changeset publish",
    "example": "tsx ./example/index.ts"
  },
  "keywords": [
    "fetch",
    "http",
    "interceptors",
    "decoder",
    "validation",
    "typescript"
  ],
  "files": [
    "build",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "Joshua Amaju <joshsemail4work@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/joshamaju/jamx",
    "directory": "packages/http"
  },
  "homepage": "https://github.com/joshamaju/jamx/tree/main/packages/http",
  "bugs": {
    "url": "https://github.com/joshamaju/jamx/issues"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/node": "^25.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  }
}
