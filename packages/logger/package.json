{
  "name": "@jamx/logger",
  "version": "0.3.0",
  "description": "Composable structured logging primitives for TypeScript and Node.js",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./Logger": {
      "types": "./build/Logger.d.ts",
      "import": "./build/Logger.js",
      "default": "./build/Logger.js"
    },
    "./Formatter": {
      "types": "./build/Formatter.d.ts",
      "import": "./build/Formatter.js",
      "default": "./build/Formatter.js"
    },
    "./Processor": {
      "types": "./build/Processor.d.ts",
      "import": "./build/Processor.js",
      "default": "./build/Processor.js"
    },
    "./Transport": {
      "types": "./build/Transport.d.ts",
      "import": "./build/Transport.js",
      "default": "./build/Transport.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "benchmark": "pnpm run benchmark:core",
    "benchmark:core": "tsx ./benchmark/core.ts",
    "benchmark:comparison": "tsx ./benchmark/comparison.ts",
    "benchmark:worker": "pnpm build && tsx ./benchmark/worker.ts",
    "test": "vitest run",
    "prepublish": "pnpm build",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "typecheck:benchmarks": "tsc --noEmit --module nodenext --moduleResolution nodenext --target ES2020 --strict --esModuleInterop --skipLibCheck benchmark/*.ts",
    "version": "changeset version",
    "release": "changeset publish",
    "dev": "tsx ./example/basic.ts",
    "example:basic": "tsx ./example/basic.ts",
    "example:structured": "tsx ./example/structured.ts",
    "example:writer-pretty": "tsx ./example/writer-pretty.ts",
    "example:context": "tsx ./example/context.ts",
    "example:processor": "tsx ./example/processor.ts",
    "example:memory": "tsx ./example/memory.ts",
    "example:composite": "tsx ./example/composite-transport.ts",
    "example:formatter": "tsx ./example/custom-formatter.ts",
    "example:printf": "tsx ./example/printf.ts",
    "example:line": "tsx ./example/line-console.ts",
    "example:worker": "pnpm build && tsx ./example/worker/main.ts",
    "typecheck:examples": "tsc --noEmit --module nodenext --moduleResolution nodenext --target ES2020 --strict --noUnusedLocals --noUnusedParameters --esModuleInterop --skipLibCheck example/*.ts example/worker/*.ts"
  },
  "keywords": [
    "logger",
    "log",
    "console"
  ],
  "files": [
    "build",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "Joshua Amaju <joshsemail4work@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/joshamaju/jamx",
    "directory": "packages/logger"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/node": "^25.3.3",
    "elegant-spinner": "^3.0.0",
    "pino": "^10.3.1",
    "pino-abstract-transport": "^3.0.0",
    "tinybench": "^3.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18",
    "winston": "^3.19.0"
  },
  "dependencies": {
    "@paydirt/fmt": "^0.3.1"
  }
}
